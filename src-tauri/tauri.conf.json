{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpsDeck",
  "version": "0.6.1",
  "identifier": "dev.opsdeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpsDeck",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "DevOps cockpit: terminal with local AI, Kubernetes, SSH, databases, notes, KeePass",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "longDescription": "OpsDeck is a free open-source desktop app for DevOps engineers: a terminal with a local AI assistant, Kubernetes, SSH, databases, an IDE with git, alerts, notes with tasks and KeePass in one window.",
    "license": "MIT",
    "homepage": "https://leoalecksey.github.io/opsdeck/",
    "publisher": "LeoAlecksey",
    "copyright": "Copyright (c) LeoAlecksey and contributors, MIT License"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCMTYyRjNEOUJBMjAyNTUKUldSVkFxS2JQUzhXSzVQdi9iSjFFc0lxdTVTejJFdjk2cURRV0JRTndGbWlqSVZvN29CaXBPWGcK",
      "endpoints": [
        "https://github.com/LeoAlecksey/opsdeck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
