# OpsDeck shell integration for zsh
ZDOTDIR="$__opsdeck_user_zdotdir"
[[ "$ZDOTDIR" == "$HOME" ]] && unset ZDOTDIR

# If login shell, source user's .zprofile first so PATH (brew/pyenv/kubectl/etc.) is initialized
[[ -o login && -f "${ZDOTDIR:-$HOME}/.zprofile" ]] && source "${ZDOTDIR:-$HOME}/.zprofile"
[[ -f "${ZDOTDIR:-$HOME}/.zshrc" ]] && source "${ZDOTDIR:-$HOME}/.zshrc"

if [[ -z "$__OPSDECK_SI" ]]; then
  __OPSDECK_SI=1
  autoload -Uz add-zsh-hook
  __opsdeck_precmd() {
    local ec=$?
    print -n "\e]133;D;${ec}\a\e]133;A\a\e]7;file://${HOST}${PWD}\a"
  }
  __opsdeck_preexec() {
    print -n "\e]133;E;$(print -rn -- "$1" | base64 -w0)\a\e]133;C\a"
  }
  add-zsh-hook precmd __opsdeck_precmd
  add-zsh-hook preexec __opsdeck_preexec
  PS1="${PS1}%{"$'\e]133;B\a'"%}"
fi

# ssh typed in an OpsDeck tab shares its connection with the resource bar (ControlMaster)
if [[ -n "$OPSDECK_SSH_CP" && -z "$__OPSDECK_SSH_WRAP" ]]; then
  __OPSDECK_SSH_WRAP=1
  ssh() { command ssh -o ControlMaster=auto -o "ControlPath=\"$OPSDECK_SSH_CP\"" -o ControlPersist=60 "$@"; }
fi
